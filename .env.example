# AI-COS environment variables
#
# The AI layer (src/app/api/ai/route.ts) calls Anthropic's Claude. Set this to
# enable live AI. Without it, every AI surface still works using the
# deterministic fallbacks built into each feature.
ANTHROPIC_API_KEY=

# Optional: override the model used by the AI layer.
# AI_COS_MODEL=claude-sonnet-5
